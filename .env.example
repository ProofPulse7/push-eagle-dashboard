# Next.js dashboard — copy to .env.local for local dev.
# On Vercel (push-eagle-dashboard project): set NEON_DATABASE_URL (and optionally SHOPIFY_SESSION_DATABASE_URL).

NEXT_PUBLIC_APP_URL=https://push-eagle-dashboard.vercel.app
SHOPIFY_APP_URL=https://push-eagle-dashboard.vercel.app
SHOPIFY_ROOT_APP_URL=https://push-eagle.vercel.app
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_DASHBOARD_SSO_SECRET=
CRON_SECRET=

# Neon production branch (pooler). Same URL as Remix DATABASE_URL. Replace PASSWORD.
NEON_DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-weathered-wind-aogxzw4p-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
SHOPIFY_SESSION_DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-weathered-wind-aogxzw4p-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-weathered-wind-aogxzw4p-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

DATABASE_PROVIDER=neon
