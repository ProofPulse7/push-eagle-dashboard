# Next.js dashboard — copy to .env.local for local dev.
# On Vercel (push-eagle-dashboard project): set NEON_DATABASE_URL (and optionally SHOPIFY_SESSION_DATABASE_URL).

NEXT_PUBLIC_APP_URL=https://push-eagle-dashboard.vercel.app
SHOPIFY_APP_URL=https://push-eagle-dashboard.vercel.app
SHOPIFY_ROOT_APP_URL=https://push-eagle.vercel.app
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_DASHBOARD_SSO_SECRET=
CRON_SECRET=

# GDPR export email (required for customers/data_request webhook delivery)
RESEND_API_KEY=
GDPR_EXPORT_FROM_EMAIL=support@push-eagle.com

# Production billing — leave unset or set to false (never true in production)
SHOPIFY_BILLING_TEST=false

# --- Cost optimization (recommended for production) ---
# D1 + KV + Queue auto-enable when IDs/token/WORKER_URL are set (see resolve-env.ts).
AUTOMATION_QUEUE_ENABLED=true
CLOUDFLARE_WORKER_URL=https://push-eagle-cron-pinger.<your-subdomain>.workers.dev
CLOUDFLARE_ACCOUNT_ID=d889f0c23f53a9054e3ddf29872defd7
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_KV_NAMESPACE_ID=29ce646c32eb44d884376f1201749452
CLOUDFLARE_D1_DATABASE_ID=
# Dedicated D1 for delivery/click detail (campaign + automation deliveries/clicks).
CLOUDFLARE_D1_DELIVERIES_DATABASE_ID=
D1_EVENTS_ENABLED=true
# Move delivery/click detail tables to D1 (dedicated CLOUDFLARE_D1_DELIVERIES_DATABASE_ID).
# After POST /api/admin/deliveries/backfill-d1 { "action": "backfill" } and parity, purge Neon copies.
D1_DELIVERIES_ENABLED=false
# Commerce / customer / catalog cache on D1 (main CLOUDFLARE_D1_DATABASE_ID).
# Enable all three in production after running POST /api/admin/commerce/backfill-d1 { "action": "all" }.
D1_COMMERCE_ENABLED=false
D1_CUSTOMERS_ENABLED=false
D1_CATALOG_ENABLED=false

# R2 (media + pixel archive under pixel-archive/ prefix)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=pusheagle-images
R2_S3_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Neon production branch (pooler). Same URL as Remix DATABASE_URL. Replace PASSWORD.
NEON_DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-weathered-wind-aogxzw4p-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
SHOPIFY_SESSION_DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-weathered-wind-aogxzw4p-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-weathered-wind-aogxzw4p-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

DATABASE_PROVIDER=neon

# Firebase (FCM — free at scale)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
