# Dashboard (push-eagle-dashboard Vercel project) — copy to .env.local

DATABASE_PROVIDER=neon
NEXT_PUBLIC_APP_URL=https://push-eagle-dashboard.vercel.app
SHOPIFY_APP_URL=https://push-eagle-dashboard.vercel.app

# Paste without wrapping quotes in Vercel (no " at start/end)
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Same Neon DB as push-eagle DATABASE_URL (public.Session table)
SHOPIFY_SESSION_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_DASHBOARD_SSO_SECRET=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_SCOPES=read_customers,read_orders,read_products,write_products,write_metaobjects,write_metaobject_definitions
SHOPIFY_ROOT_APP_URL=https://push-eagle.vercel.app
NEXT_PUBLIC_SHOPIFY_ROOT_APP_URL=https://push-eagle.vercel.app
# Test Shopify app subscription charges (Plans page). Set on Vercel dashboard project — not shopify.app.toml.
SHOPIFY_BILLING_TEST=true

# Firebase, R2, CRON_SECRET — see your existing Vercel export
